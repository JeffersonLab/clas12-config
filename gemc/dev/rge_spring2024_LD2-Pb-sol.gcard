<!-- GEMC dev -->
<gcard>



	<!-- targets -->
	<detector name="experiments/clas12/targets/target"    factory="TEXT" variation="rge_spring2024_LD2_Pb"/>
	<detector name="experiments/clas12/targets/cad_rge/"  factory="CAD"  variation="rge_spring2024_LD2_Pb"/>

	<!-- central detectors 	-->
	<detector name="experiments/clas12/bst/bst"               factory="TEXT" variation="rge_spring2024"/>
	<detector name="experiments/clas12/micromegas/micromegas" factory="TEXT" variation="rge_spring2024"/>

	<!--ctof, cnd  -->
	<detector name="experiments/clas12/ctof/ctof"    factory="TEXT" variation="rga_fall2018"/>
	<detector name="experiments/clas12/ctof/cad/"    factory="CAD"  variation="rga_fall2018"/>
	<detector name="experiments/clas12/cnd/cnd"      factory="TEXT" variation="rga_fall2018"/>

	<!--high threshold cherenkov -->
	<detector name="experiments/clas12/htcc/htcc"  factory="TEXT" variation="rga_fall2018"/>
	<detector name="experiments/clas12/htcc/cad/"  factory="CAD"  variation="rga_fall2018"/>

	<!-- magnets -->
	<detector name="experiments/clas12/magnets/magnets" factory="TEXT" variation="rga_fall2018"/>
	<detector name="experiments/clas12/magnets/cad/"     factory="CAD" />

	<!-- FT/Beamline configuration -->
	<detector name="experiments/clas12/ft/ft"             factory="TEXT" variation="rgd_fall2023"/>
	<detector name="experiments/clas12/beamline/cad/"     factory="CAD"  variation="rgd_fall2023"/>
	<detector name="experiments/clas12/beamline/beamline" factory="TEXT" variation="rgd_fall2023"/>

	<!-- Detectors in the forward carriage -->
	<detector name="experiments/clas12/dc/dc"       factory="TEXT" />
	<detector name="experiments/clas12/dc/cad/"     factory="CAD"/>
	<detector name="experiments/clas12/ftof/ftof"   factory="TEXT" variation="rga_spring2018"/>
	<detector name="experiments/clas12/ec/ec"       factory="TEXT" variation="rga_spring2018"/>
	<detector name="experiments/clas12/pcal/pcal"   factory="TEXT" variation="rga_spring2018"/>
	<detector name="experiments/clas12/ltcc/ltcc"   factory="TEXT" variation="rgm_fall2021_H"/>
	<detector name="experiments/clas12/ltcc/cad/"   factory="CAD"  variation="rgm_fall2021_H"/>
	<detector name="experiments/clas12/rich/rich"   factory="TEXT" variation="rgc_summer2022"/>
	<detector name="experiments/clas12/rich/cad/"   factory="CAD"  variation="rgc_summer2022"/>


	<!-- you can scale the fields here. Remember torus -1 means e- INBENDING  -->
	<option name="SCALE_FIELD" value="binary_torus, -1"/>
	<option name="SCALE_FIELD" value="binary_solenoid, -1"/>

	<!-- hall field  -->
	<option name="HALL_FIELD"  value="Symm_solenoid_r601_phi1_z1201_13June2018:Symm_torus_r2501_phi16_z251_24Apr2018"/>


	<!-- beam conditions: liquid target z pos is -6.5cm, solid is -1.5cm -->
	<option name="BEAM_P"   value="e-, 10.6*GeV, 0.0*deg, 0*deg"/>
	<option name="BEAM_V"    value="(0, 0, -6.5)cm"/>
	<option name="SPREAD_V"  value="(0.0, 1.0)cm"/>

	<option name="SAVE_ALL_MOTHERS" value="1"/>
	<option name="RECORD_OPTICALPHOTONS"   value="1"/>
 	<option name="SKIPREJECTEDHITS"    value="1" />



	<option name="PHYSICS" value="FTFP_BERT + STD + Optical"/>

	<option name="OUTPUT"   value="hipo, out.hipo"/>

	<!--  Will print message every 10 events -->
	<option name="PRINT_EVENT"    value="100" />


	<!--  Run Number 11, picked up by digitization routines -->
	<option name="RUNNO"    value="11" />
	<option name="DIGITIZATION_VARIATION"  value="rga_fall2018_mc" />

	<!--  Do not track staff after the apex -->
	<option name="MAX_Z_POS" value="9000"/>

	<!--  Time window defined by LUMI_EVENT -->
	<option name="LUMI_EVENT"  value="0, 248.5*ns, 2.004*ns" />
	<!--  Uncomment this (and replace the LUMI_EVENT Above) to simulate 10^35 luminosity beam on a 5cm liquid hydrogen target, use 124K e- / event   -->
	<!--  Scale accordingly for different target / luminosity  -->
	<!--
	<option name="LUMI_EVENT"     value="124000, 248.5*ns, 2.004*ns" />
	<option name="LUMI_P"         value="e-, 10.6*GeV, 0*deg, 0*deg" />
	<option name="LUMI_V"         value="(0.0, 0.0, -10)cm" />
	<option name="LUMI_SPREAD_V"  value="(0.03, 0.03)cm" />
	-->

	<!--  RF Signal needs event time window defined by LUMI_EVENT -->
	<!--  Reference position set as target shift below -->
	<option name="RFSETUP"     value="clas12_ccdb" />
	<option name="RFSTART"     value="eventVertex, 0, 0, -30.0" />

	<!-- production threshold for passive volumes -->
	<!-- beamline shielding and torus magnet: 2cm-->
        <option name="PRODUCTIONCUTFORVOLUMES" value="FTInnerShieldAndFlange, FTOuterFlange, FTOuterMount, FTInnerShieldAndFlange_Bolt1, FTInnerShieldAndFlange_Bolt2, FTInnerShieldAndFlange_Bolt3, FTInnerShieldAndFlange_Bolt4, FTInnerShieldAndFlange_Bolt5, FTInnerShieldAndFlange_Bolt6, FTInnerShieldAndFlange_Bolt7, FTInnerShieldAndFlange_Bolt8, FTInnerShieldAndFlange_Bolt9, FTInnerShield, moller_cone, ft_adjuster, Apex_Shield_Lead_Fill, Apex_Shield_Hub, Downstream_Beam_tube_Segment_1, Downstream_Beam_tube_Segment_2, Beamline_Adapter_1, Torus_Exit_Shield_Casing, Torus_Exit_Shield_Lead_Fill, 20" />
        <option name="PRODUCTIONCUTFORVOLUMES" value="BoreShield, BoreCenterTube, DownstreamShieldingPlate, DownstreamVacuumJacket, WarmBoreTube, hub_shield1, hub_shield, hub_shield3, hub_shield4, hub_shield5, hub_shield6, hub_shield7, vacuumJacket, vacuumJacket1b, vacuumJacket2a, vacuumJacket2b, vacuumJacket3a, vacuumJacket3b, vacuumJacket4a, vacuumJacket4b, vacuumJacket5a, vacuumJacket5b, vacuumJacket6a, vacuumJacket6b, 20" />

	<!--  Target and central detectors are all shifted upstream by 30 mm -->
	<detector name="svt">       <position x="0*cm"     y="0*cm"     z="-3.00*cm"  />  </detector>
	<detector name="bstShield"> <position x="0*cm"     y="0*cm"     z="-3.00*cm"  />  </detector>

	<!-- solenoid volume and field map shifted upstream by 30 mm -->
	<option name="DISPLACE_FIELDMAP"     value="binary_solenoid, 0*cm, 0*cm, -3.00*cm" />

</gcard>